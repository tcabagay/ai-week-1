{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "create-block/one-shot-interactivity-quiz",
	"version": "0.1.0",
	"title": "One Shot Interactivity Quiz",
	"category": "widgets",
	"icon": "smiley",
	"description": "Interactive quiz block with immediate answer feedback.",
	"example": {},
	"supports": {
		"html": false
	},
	"attributes": {
		"question": {
			"type": "string",
			"default": ""
		},
		"answers": {
			"type": "array",
			"default": [
				{ "text": "", "isCorrect": false },
				{ "text": "", "isCorrect": false }
			]
		}
	},
	"textdomain": "one-shot-interactivity-quiz",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}
